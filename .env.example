# ─── Server ────────────────────────────────────────────────────────────────
# Port the Flask/Gunicorn server listens on (ClawCloud injects this automatically)
PORT=8000

# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://waf_admin:change_me@localhost:5432/waf_saas
# SQLite fallback for quick local testing (no PostgreSQL needed):
# DATABASE_URL=sqlite:///waf_saas.db

# ─── Security ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-32chars-min
JWT_SECRET_KEY=change-me-jwt-in-production-32chars-min

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS (use your frontend URL in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Nginx/ModSecurity config paths ────────────────────────────────────────
# Directories where the API writes generated Nginx and ModSecurity configs.
# Use /tmp paths when Nginx is not co-located with the API container.
NGINX_CONF_DIR=/tmp/waf-nginx-sites
MODSEC_RULES_DIR=/tmp/waf-modsec-sites
LOG_DIR=/tmp/waf-logs
NGINX_LOG_DIR=/tmp/waf-nginx-logs