# Database
POSTGRES_DB=waf_saas
POSTGRES_USER=waf_admin
POSTGRES_PASSWORD=waf_secret_2026
DATABASE_URL=postgresql://waf_admin:waf_secret_2026@db:5432/waf_saas

# Flask
SECRET_KEY=waf-pssn-2026-change-this-in-production-min-32-chars
JWT_SECRET_KEY=jwt-pssn-2026-change-this-in-production-min-32-chars
FLASK_ENV=production

# Paths
NGINX_CONF_DIR=/etc/nginx/conf.d
NGINX_TEMPLATE_DIR=/app/nginx_templates
MODSEC_RULES_DIR=/etc/nginx/modsecurity/sites
LOG_DIR=/var/log/modsecurity
NGINX_LOG_DIR=/var/log/nginx
