# Version control
.git
.gitignore

# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/env/
**/venv/
**/.venv/
**/.env
**/*.egg-info/
**/dist/
**/build/
**/.pytest_cache/

# Frontend (not needed in backend image)
frontend/

# Docker files
docker/
docker-compose*.yml

# CI/CD
.github/

# Docs & misc
*.md
LICENSE
CONTRIBUTING.md
MASTERPLAN.md
scripts/

# Nginx / ModSecurity (managed at runtime, not baked in)
nginx/
modsecurity/

# Logs
**/*.log
